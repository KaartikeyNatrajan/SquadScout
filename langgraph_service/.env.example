# Copy to .env (make setup does this) and adjust. .env is git-ignored.
FPL_GRPC_ADDR=localhost:50051
GRPC_TIMEOUT_S=15

# Which model answers: vllm (local) or anthropic (Claude, paid per use).
LLM_PROVIDER=vllm

# Claude, when LLM_PROVIDER=anthropic. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=squad-scout-llm
LLM_TEMPERATURE=0

GRAPH_RECURSION_LIMIT=12
