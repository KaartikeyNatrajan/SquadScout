# Most editors (VS Code with the EditorConfig extension, JetBrains) honour this,
# so files saved from Windows keep LF endings.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[{*.yml,*.yaml,*.proto,*.toml}]
indent_size = 2
